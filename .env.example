# gitdocs configuration
# Copy to .env and edit. Every variable below is optional; the defaults shown are used when unset.

# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------

# Path to the content git repo. gitdocs creates and `git init`s it on first boot
# if it does not exist. Every page is a markdown file under this directory.
# The path must be absolute; a relative path is rejected at startup.
GITDOCS_CONTENT_DIR=/Users/pmihaylov/prg/repos/gitdocs/.data/content

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# TCP port for the Fastify REST API. Must be 1-65535.
GITDOCS_PORT=4000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# If BOTH GITDOCS_API_TOKENS and GITDOCS_PASSWORD are empty, gitdocs runs in
# OPEN mode: no authentication at all, and it logs a loud warning on boot.
# Never do that on a public network.

# Comma-separated bearer tokens for agents and scripts.
# Used as: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
GITDOCS_API_TOKENS=

# Password for the web UI login form. POST /api/v1/auth/login exchanges it for a
# signed httpOnly session cookie.
GITDOCS_PASSWORD=

# Secret used to sign the session cookie. Set a long random value in production,
# otherwise sessions are invalidated on every restart.
# Generate with: openssl rand -hex 32
GITDOCS_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------

# Optional remote URL for the content repo. Leave empty to stay purely local
# (commits still happen, push and pull become no-ops).
GITDOCS_GIT_REMOTE=

# Branch used for commits, pulls and pushes.
GITDOCS_GIT_BRANCH=main

# Identity stamped on automatic commits.
GITDOCS_GIT_AUTHOR_NAME=gitdocs
GITDOCS_GIT_AUTHOR_EMAIL=gitdocs@localhost

# Debounce in milliseconds between the last edit and the automatic commit.
# 0 disables auto-commit; commit then only via POST /api/v1/git/commit.
GITDOCS_AUTOCOMMIT_MS=5000

# Interval in milliseconds between background `git pull` runs. 0 turns it off.
GITDOCS_AUTOPULL_MS=60000
