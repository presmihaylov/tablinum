# tablinum configuration
# Copy to .env and edit. Every variable below is optional; the defaults shown are used when unset.

# ---------------------------------------------------------------------------
# Content
# ---------------------------------------------------------------------------

# Path to the content git repo. tablinum creates and `git init`s it on first boot
# if it does not exist. Every page is a markdown file under this directory.
# The path must be absolute; a relative path is rejected at startup.
TABLINUM_CONTENT_DIR=/Users/pmihaylov/prg/repos/tablinum/.data/content

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# TCP port for the Fastify REST API. Must be 1-65535.
TABLINUM_PORT=4000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# People sign in with an account. The first visitor to a fresh server creates
# the first admin, and everybody else joins through an invite link. Nothing
# here is needed for that.

# Comma-separated bearer tokens for agents and scripts.
# Used as: Authorization: Bearer <token>
# Generate with: openssl rand -hex 32
TABLINUM_API_TOKENS=

# Secret used to sign the session cookie. Set a long random value in production,
# otherwise sessions are invalidated on every restart.
# Generate with: openssl rand -hex 32
TABLINUM_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Git
# ---------------------------------------------------------------------------

# Optional remote URL for the content repo. Leave empty to stay purely local
# (commits still happen, push and pull become no-ops).
TABLINUM_GIT_REMOTE=

# Branch used for commits, pulls and pushes.
TABLINUM_GIT_BRANCH=main

# Identity stamped on automatic commits.
TABLINUM_GIT_AUTHOR_NAME=tablinum
TABLINUM_GIT_AUTHOR_EMAIL=tablinum@localhost

# Debounce in milliseconds between the last edit and the automatic commit.
# 0 disables auto-commit; commit then only via POST /api/v1/git/commit.
TABLINUM_AUTOCOMMIT_MS=5000

# Interval in milliseconds between background `git pull` runs. 0 turns it off.
TABLINUM_AUTOPULL_MS=60000

# Quiet period in milliseconds after a commit before the branch is pushed.
# 0 turns the automatic push off; push then only via POST /api/v1/git/push.
# Needs TABLINUM_GIT_REMOTE.
TABLINUM_AUTOPUSH_MS=5000

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------

# Slack bot token, used to tell a person that a page mentions them.
# Leave it empty to turn mention notifications off.
# The bot needs the scopes chat:write and users:read.email.
TABLINUM_SLACK_BOT_TOKEN=

# Public origin of this server, used for the link in a notification.
# Slack cannot resolve "localhost", so set this when you run behind a domain.
TABLINUM_PUBLIC_URL=

# Trust X-Forwarded-Proto and X-Forwarded-For. Turn this on only behind a reverse
# proxy you control. Without it the proxy's plain http hop makes the session cookie
# lose its Secure flag, and a private browser window then drops it.
TABLINUM_TRUST_PROXY=false
