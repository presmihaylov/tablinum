{
  "name": "@gitdocs/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify REST API for gitdocs: wires the content store, the git engine and the search index together.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.1",
    "@gitdocs/core": "workspace:*",
    "@gitdocs/git-sync": "workspace:*",
    "@gitdocs/search": "workspace:*",
    "@gitdocs/shared": "workspace:*",
    "chokidar": "^4.0.3",
    "fastify": "^5.3.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
