# gitdocs - docker compose environment.
# Copy to deploy/.env and edit. docker compose reads deploy/.env automatically.
#
#   cp deploy/.env.example deploy/.env
#
# GITDOCS_CONTENT_DIR, GITDOCS_SEARCH_DB and GITDOCS_PORT are forced by
# docker-compose.yml, so they are not repeated here.

# ---------------------------------------------------------------------------
# Auth - people sign in with an account. The first visitor to a fresh server
# creates the first admin, so open the app yourself before anybody else does.
# ---------------------------------------------------------------------------

# Comma-separated bearer tokens for agents, scripts and the MCP server.
# Use one token per consumer, so you can revoke one without breaking the rest.
# Generate: openssl rand -hex 32
GITDOCS_API_TOKENS=

# Signs the session cookie. Keep it stable, otherwise every restart logs
# everybody out. Generate: openssl rand -hex 32
GITDOCS_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Git remote - the backup and the sync channel. Leave empty to stay local.
# ---------------------------------------------------------------------------

# SSH:   git@github.com:acme/docs-content.git
# HTTPS: https://x-access-token:<TOKEN>@github.com/acme/docs-content.git
GITDOCS_GIT_REMOTE=

GITDOCS_GIT_BRANCH=main
GITDOCS_GIT_AUTHOR_NAME=gitdocs
GITDOCS_GIT_AUTHOR_EMAIL=gitdocs@localhost

# Debounce between the last edit and the automatic commit. 0 disables it.
GITDOCS_AUTOCOMMIT_MS=5000

# Interval between background pulls. 0 turns the background pull off.
GITDOCS_AUTOPULL_MS=60000

# Host keys of the git remote, used when you mount an SSH key.
# Generate: ssh-keyscan github.com
# GITDOCS_SSH_KNOWN_HOSTS=

# ---------------------------------------------------------------------------
# Slack - tells a person that a page mentions them. Leave empty to turn it off.
# ---------------------------------------------------------------------------

# Bot token of your Slack app. Scopes: chat:write and users:read.email.
GITDOCS_SLACK_BOT_TOKEN=

# Public origin people reach gitdocs on, used for the link in the message.
# Slack cannot resolve "localhost", so set this, e.g. https://docs.example.com
GITDOCS_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Optional Caddy service (commented out in docker-compose.yml)
# ---------------------------------------------------------------------------

# Internal hostname, resolvable only on the VPN, e.g. docs.vpn.example.com
# GITDOCS_HOSTNAME=

# Only for the Let's Encrypt DNS-01 variant.
# ACME_EMAIL=
# CLOUDFLARE_API_TOKEN=
