{
  "name": "tablinum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.9.0",
  "description": "Self-hosted docs app with a block editor UI, backed by a git repo of markdown files.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:plain": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @tablinum/server dev\" \"pnpm --filter @tablinum/web dev\"",
    "seed": "pnpm --filter @tablinum/shared build && tsx scripts/seed.ts",
    "build": "pnpm -r --sequential build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "clean": "pnpm -r exec rm -rf dist tsconfig.tsbuildinfo",
    "docker:build": "docker build -f deploy/Dockerfile -t tablinum:latest ."
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
