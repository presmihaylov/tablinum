{
  "name": "@tablinum/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Content store for tablinum: markdown files with YAML frontmatter, page tree, id index, links and views.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@tablinum/shared": "workspace:*",
    "chokidar": "^4.0.3",
    "gray-matter": "^4.0.3",
    "yaml": "^2.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
